# Root — copy to .env and adjust. NEVER commit real .env files.

# ---- Database (Postgres, installed locally — no Docker needed) ----
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/collabcanvas?schema=public"
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5432/collabcanvas_test?schema=public"

# ---- Auth ----
# Generate with: openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string"
# Comma-separated list of allowed web origins for CORS
WEB_ORIGIN="http://localhost:3000"

# ---- OAuth (create apps at github.com/settings/developers and console.cloud.google.com) ----
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Where OAuth callbacks return: the API's public base URL
API_PUBLIC_URL="http://localhost:3001"

# ---- AI (cost-controlled; proxy only — keys never reach the client) ----
# mock = deterministic provider used for tests/demos without a key
AI_ENABLED="true"
AI_PROVIDER="mock" # mock | openai | ollama | huggingface | gemini
# Per-request provider timeout; raise this on slow local hardware (Ollama on CPU)
AI_TIMEOUT_MS="60000"
# Only the selected provider's variables are required; leave the rest empty.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
# Local model (no cloud key): start Ollama, `ollama pull llama3.2`
# OLLAMA_MODEL must match a name from `ollama list` (e.g. `llama3.2` or `llama3.2:3b`)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"
# Hugging Face (required when AI_PROVIDER=huggingface)
HF_TOKEN=""
HF_MODEL="" # e.g. "Qwen/Qwen3-8B" or "Qwen/Qwen3-8B:featherless-ai"
HF_PROVIDER="" # optional Inference Provider pin, e.g. "featherless-ai"; empty = SDK auto selection
HF_ENDPOINT_URL="" # optional dedicated Inference Endpoint; replaces the hosted route when set
# Google Gemini (required when AI_PROVIDER=gemini)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# ---- Optional Redis (rate limiting). Falls back to in-memory when unset ----
REDIS_URL=""

# ---- Realtime (y-websocket) ----
REALTIME_PORT="3002"

# ---- Web (Next.js, public env vars) ----
# Build-time ONLY. These are inlined into the client bundle at `next build` time,
# so they must be set in .env.local / CI / any deployment. Do NOT use a
# localhost fallback in production (it silently sends every socket to a dead
# port instead of failing fast).
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_WS_URL="ws://localhost:3002"  # wss://collabcanvas-realtime.onrender.com in production
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SENTRY_DSN=""

# ---- API ----
PORT="3001"
LOG_LEVEL="info"
SENTRY_DSN=""

# ---- E2E (Playwright) ----
E2E_USER_EMAIL="alice@example.com"
E2E_USER_PASSWORD="password123"
