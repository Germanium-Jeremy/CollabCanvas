{
  "name": "@collabcanvas/realtime",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted Yjs WebSocket server: JWT auth, room roles, persistence",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "dotenv -e ../../.env -- node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@collabcanvas/shared": "workspace:*",
    "@collabcanvas/yjs-utils": "workspace:*",
    "@prisma/client": "^6.5.0",
    "jsonwebtoken": "^9.0.2",
    "lib0": "^0.2.94",
    "ws": "^8.18.0",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.18"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.15.0",
    "@types/ws": "^8.18.0",
    "tsx": "^4.19.0",
    "dotenv-cli": "^8.0.0",
    "vitest": "^3.1.0"
  }
}
